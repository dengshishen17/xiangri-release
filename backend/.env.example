# ==========================================================================
# 巷里 XIANGRI · 后端运行所需环境变量示例
# ==========================================================================
# 复制为 .env 并填入真实值后再启动容器。
# .env 已被 .gitignore 忽略，切勿把真实密钥提交到仓库。
#
# 变量名与 docker-compose.yml 中引用的完全一致，不要随意改名。
# ==========================================================================

# ── MySQL ──────────────────────────────────────────────────────────
DB_URL=jdbc:mysql://host.docker.internal:3306/hmdp?useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# ── Redis ──────────────────────────────────────────────────────────
# 使用编排文件内置的 Redis 时保持 hmdp-redis；
# 连接已有 Redis 时改为该实例的可达地址。
REDIS_HOST=hmdp-redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ── 图片上传目录（宿主机路径，挂载到容器内 /app/imgs）────────────────
# 留空则使用编排文件同级的 ./imgs 目录。
# Windows 示例：IMAGE_UPLOAD_HOST_DIR=E:/hm-nginx-1.18.0/html/hmdp/imgs
IMAGE_UPLOAD_HOST_DIR=

# ==========================================================================
# 说明：以下为 IDE / 命令行直跑时使用的变量，docker compose 不引用。
#   SERVER_PORT        后端监听端口，默认 8081
#   IMAGE_UPLOAD_DIR   图片上传目录（直跑场景下直接写目标路径）
#
# 预留的第三方服务密钥（当前代码未直接使用）：
#   DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL
#   ALIYUN_ACCESS_KEY_ID / ALIYUN_ACCESS_KEY_SECRET / ALIYUN_REGION
# ==========================================================================
